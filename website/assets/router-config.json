  ],
  "decisions": [
    {
      "name": "emergency_stop",
      "priority": 1000,
      "when": {
        "safety": "critical"
      },
      "candidates": [
        "safety-controller"
      ],
      "algorithm": "static"
    },
    {
      "name": "realtime_manipulation",
      "priority": 300,
      "when": {
        "intent": "manipulation",
        "horizon": "short"
      },
      "candidates": [
        "pi0-3b",
        "gr00t-n1.5-3b",
        "smolvla-450m",
        "openvla-7b"
      ],
      "algorithm": "latency_aware"
    },
    {
      "name": "navigation",
      "priority": 290,
      "when": {
        "intent": "navigation",
        "horizon": "short"
      },
      "candidates": [
        "nav-policy-onboard"
      ],
      "algorithm": "latency_aware"
    },
    {
      "name": "long_horizon_task",
      "priority": 200,
      "when": {
        "any": [
          {
            "intent": "planning"
          },
          {
            "horizon": "long"
          }
        ]
      },
      "candidates": [
        "claude-sonnet-5-5",
        "qwen3-8b",
        "smollm2-1.7b"
      ],
      "algorithm": "hybrid"
    },
    {
      "name": "scene_understanding",
      "priority": 150,
      "when": {
        "intent": "perception"
      },
      "candidates": [
        "qwen2.5-vl-7b",
        "claude-sonnet-5-5"
      ],
      "algorithm": "hybrid"
    },
    {
      "name": "diagnostics",
      "priority": 120,
      "when": {
        "intent": "diagnostics"
      },
      "candidates": [
        "smollm2-1.7b",
        "qwen3-8b",
        "claude-sonnet-5-5"
      ],
      "algorithm": "hybrid",
      "prefer": "latency"
    },
    {
      "name": "conversation",
      "priority": 0,
      "when": {},
      "candidates": [
        "smollm2-1.7b",
        "qwen3-8b",
        "claude-sonnet-5-5"
      ],
      "algorithm": "hybrid",
      "prefer": "latency"
    }
  ],
  "guardrails": {
    "elevated": {
      "max_speed_mps": 0.25,
      "max_force_n": 20,
      "min_safety_tier": 2,
      "require_confirmation": false
    }
  }
}
